# Sao chep thanh .env hoac chay ChuanBi-Database.ps1 de tu tao mat khau rieng.
SQL_SA_PASSWORD=REPLACE_WITH_YOUR_LOCAL_SQL_ADMIN_PASSWORD
SQL_APP_PASSWORD=REPLACE_WITH_YOUR_LOCAL_SQL_APP_PASSWORD
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_YOUR_LOCAL_ADMIN_PASSWORD
# Bi mat ky phien may chu; KHONG dung de dang nhap truc tiep cac may POS.
FOURCHANG_POS_KEY=REPLACE_WITH_YOUR_RANDOM_SERVER_KEY
FOURCHANG_LOCAL=true
FOURCHANG_DATABASE=FourChangDb
FOURCHANG_SQL_SERVER=127.0.0.1,14330
FOURCHANG_API_URL=http://localhost:15181
