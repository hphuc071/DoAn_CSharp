# Sao chep thanh .env hoac chay ChuanBi-Database.ps1 de tu tao mat khau rieng.
SQL_SA_PASSWORD=THAY_BANG_MAT_KHAU_RIENG
SQL_APP_PASSWORD=THAY_BANG_MAT_KHAU_UNG_DUNG_RIENG
ADMIN_INITIAL_PASSWORD=THAY_BANG_MAT_KHAU_QUAN_LY_RIENG
# Bi mat ky phien may chu; KHONG dung de dang nhap truc tiep cac may POS.
FOURCHANG_POS_KEY=THAY_BANG_BI_MAT_MAY_CHU_NGAU_NHIEN
FOURCHANG_LOCAL=true
FOURCHANG_DATABASE=FourChangDb
FOURCHANG_SQL_SERVER=127.0.0.1,14330
FOURCHANG_API_URL=http://localhost:15881
FOURCHANG_WEB_URL=http://localhost:15880

# Chỉ dùng mô phỏng trong Development; không thay bằng thanh toán ngân hàng thật.
ASPNETCORE_ENVIRONMENT=Development
Payments__SimulationEnabled=false
Payments__SimulationPublicBaseUrl=http://localhost:15881
Orders__PendingPaymentTimeoutMinutes=15
Orders__CustomerCreationEnabled=false
Checkout__OrderCreationEnabled=false

# Development only: simulated tables and fixed 15000 VND delivery.
Orders__FulfillmentSimulationEnabled=false
