<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Một project chứa toàn bộ test; WinForms yêu cầu Windows. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- Cùng assembly được dùng để chạy worker WinForms độc lập, không cần project thứ hai. -->
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)xunit.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../FourChang.IntegrationClosure/FixtureSessionClock.cs" Link="Shared/FixtureSessionClock.cs" />
    <ProjectReference Include="../../src/Backend/FourChang.Infrastructure/FourChang.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Presentation/FourChang.Desktop/FourChang.Desktop.csproj" />
    <!-- Build API/Web để fixture có thể mở backend thật trước khi kiểm thử. -->
    <ProjectReference Include="../../src/Backend/FourChang.Api/FourChang.Api.csproj" />
    <ProjectReference Include="../../src/Presentation/FourChang.Web/FourChang.Web.csproj" />
  </ItemGroup>
</Project>
