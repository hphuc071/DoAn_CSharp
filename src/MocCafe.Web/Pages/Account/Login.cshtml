@page
@{ViewData["Title"]="Đăng nhập";}
<div class="auth-layout"><section class="auth-visual"><span class="eyebrow">RẤT VUI ĐƯỢC GẶP LẠI BẠN</span><div class="drink-photo sprite-2"></div><h1>Một khoảng nghỉ,<br/>một chút bình yên.</h1><p>Món quen luôn đợi bạn.</p></section><section class="auth-form"><span class="eyebrow">UC-WEB-02</span><h1>Đăng nhập</h1><p>Tiếp tục đặt món và xem những đơn của bạn.</p><form data-demo-form><label class="field">Email hoặc số điện thoại<input autocomplete="username" placeholder="Nhập email hoặc số điện thoại" required/></label><label class="field">Mật khẩu<input type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required/></label><button class="button primary full">Đăng nhập</button></form><p>Chưa có tài khoản? <a href="/Account/Register"><strong>Đăng ký ngay</strong></a></p><hr style="border:0;border-top:1px solid var(--line);margin:25px 0"/><div class="form-actions"><button class="text-button" data-preview="Tài khoản tạm khóa" data-copy="Không thể cấp phiên đăng nhập. Các đơn đang xử lý và nghĩa vụ hoàn tiền vẫn được giữ nguyên.">Tài khoản khóa</button><button class="text-button" data-preview="Đổi mật khẩu tạm" data-fields="Mật khẩu tạm|Mật khẩu mới|Xác nhận mật khẩu" data-copy="Tài khoản dùng mật khẩu tạm cần đổi mật khẩu và đăng nhập lại trước khi đặt hàng.">Mật khẩu tạm</button><button class="text-button" data-preview="Sai thông tin đăng nhập" data-copy="Email/số điện thoại hoặc mật khẩu không đúng. Vui lòng kiểm tra và thử lại.">Sai mật khẩu</button></div></section></div>
