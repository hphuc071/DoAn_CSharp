@page "/Orders"
@model FourChang.Web.Pages.Orders.IndexModel
@{ViewData["Title"]="Đơn của tôi";}
<div class="page-heading"><div><h1>Đơn của tôi</h1><p class="muted">Theo dõi các đơn hàng của bạn.</p></div><a href="/" class="button primary">Xem thực đơn</a></div><section class="panel">@if(Model.Error is not null){<p role="alert">@Model.Error</p>}else if(Model.Orders.Count==0){<h2>Chưa có đơn hàng</h2><p>Những đơn hàng của bạn sẽ được hiển thị tại đây.</p>}else{foreach(var order in Model.Orders){<article><h3>@order.GetProperty("maDonHienThi").GetString()</h3><p>@order.GetProperty("trangThai").GetString()</p></article>}}</section>
