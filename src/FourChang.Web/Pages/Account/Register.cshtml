@page
@model FourChang.Web.Pages.Account.RegisterModel
@{ViewData["Title"]="Đăng ký";}
<div class="auth-layout"><section class="auth-visual"><span class="eyebrow">CHÀO MỪNG ĐẾN VỚI 4CHANG</span><div class="drink-photo sprite-0"></div><h1>Hẹn bạn một ly<br/>cà phê thật ngon.</h1><p>Hồ sơ của bạn, khẩu vị của bạn.</p></section><section class="auth-form"><h1>Tạo tài khoản</h1><form method="post"><div asp-validation-summary="All" role="alert"></div><label class="field">Họ tên<input asp-for="HoTen" autocomplete="name" required/></label><label class="field">Tên đăng nhập<input asp-for="TenDangNhap" autocomplete="username" minlength="3" required/></label><label class="field">Email<input asp-for="Email" type="email" autocomplete="email" required/></label><label class="field">Mật khẩu<input asp-for="MatKhau" type="password" autocomplete="new-password" minlength="10" required/></label><label class="field">Xác nhận mật khẩu<input asp-for="XacNhanMatKhau" type="password" autocomplete="new-password" required/></label><button class="button primary full">Tạo tài khoản</button></form><p>Đã có tài khoản? <a href="/Account/Login"><strong>Đăng nhập</strong></a></p></section></div>
