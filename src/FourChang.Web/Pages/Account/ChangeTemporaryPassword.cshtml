@page
@model FourChang.Web.Pages.Account.ChangeTemporaryPasswordModel
@{ ViewData["Title"] = "Đổi mật khẩu tạm"; }
<div class="auth-layout">
    <section class="auth-visual"><span class="eyebrow">4CHANG LINH NGU LAM</span><div class="drink-photo sprite-2"></div><h1>Mật khẩu của bạn,<br/>do bạn giữ.</h1></section>
    <section class="auth-form">
        <h1>Đổi mật khẩu tạm</h1>
        <p>Đặt mật khẩu riêng trước khi sử dụng tài khoản. Sau khi lưu, bạn cần đăng nhập lại.</p>
        <form method="post">
            <div asp-validation-summary="All" role="alert"></div>
            <label class="field">Mật khẩu mới<input asp-for="MatKhauMoi" type="password" autocomplete="new-password" minlength="10" maxlength="128" required /></label>
            <label class="field">Xác nhận mật khẩu mới<input asp-for="XacNhanMatKhau" type="password" autocomplete="new-password" minlength="10" maxlength="128" required /></label>
            <button class="button primary full">Lưu mật khẩu mới</button>
        </form>
        <a href="/Account/Login">Quay lại đăng nhập</a>
    </section>
</div>
