<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8"/><meta name="theme-color" content="#75452d"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · 4CHANG LINH NGU LAM</title><link rel="icon" href="~/favicon.svg"/><link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/refinement.css" asp-append-version="true"/></head>
<body>
<div class="preview-strip"><span><i class="live-dot"></i> MẪU GIAO DIỆN · dữ liệu minh họa</span><label>Trạng thái xem trước <select id="scenario"><option value="normal">Bình thường</option><option value="empty">Không có dữ liệu</option><option value="offline">Mất kết nối</option><option value="error">Lỗi xử lý</option><option value="loading">Đang tải</option></select></label></div>
<header class="site-header"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">4C</span><span class="brand-name">4CHANG<em>LINH NGU LAM</em><small>Cà phê ngon, ngày an nhiên</small></span></a><nav><a href="/" class="@(ViewContext.RouteData.Values["page"]?.ToString()=="/Index"?"active":"")">Thực đơn</a><a href="/Orders">Đơn của tôi</a></nav><div class="header-actions"><a class="profile-link" href="/Account/Profile"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg><span>Hồ sơ</span></a><a href="/Account/Login">Đăng nhập</a><a class="cart-link" href="/Cart" aria-label="Giỏ hàng"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h2l3 12h10l3-8H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>Giỏ hàng <b id="cart-badge">2</b></a></div></header>
<main class="page-wrap"><div class="scenario-message" id="scenario-message" hidden role="status"></div>@RenderBody()</main>
<footer class="site-footer"><a class="brand" href="/">4CHANG LINH NGU LAM</a><span>Thưởng thức theo cách của bạn.</span><span>08:00 – 22:00 · Mỗi ngày</span><a href="/Account/Register">Trở thành khách hàng</a></footer>
<div class="toast" id="toast" role="status" hidden></div>
<dialog id="preview-dialog"><form method="dialog"><button class="icon-button close-dialog" aria-label="Đóng">×</button><span class="eyebrow">4CHANG LINH NGU LAM</span><h2 id="dialog-title">Xác nhận thao tác</h2><p id="dialog-copy"></p><div id="dialog-fields"></div><button class="button primary">Đóng xem trước</button></form></dialog>
<script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required:false)
</body></html>
