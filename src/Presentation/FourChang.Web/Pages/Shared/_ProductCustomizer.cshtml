<section class="customizer panel" aria-label="Tùy chỉnh món">
<div class="customizer-product"><div class="drink-photo selected-photo" role="img" aria-label="Món đang chọn"></div><div><h2 id="selected-name">Chọn món từ thực đơn</h2><strong id="selected-price">—</strong><span id="catalog-availability" class="status" role="status"></span><p id="selected-description"></p></div></div>
<div class="option-row"><span>Kích cỡ</span><span class="segmented" id="catalog-sizes"></span></div>
<div class="option-row"><span>Nóng / Lạnh</span><span class="segmented" id="catalog-temperatures"></span></div>
<div class="option-row"><span>Đường</span><span class="segmented" id="catalog-sugar"></span></div>
<div class="option-row"><span>Đá</span><span class="segmented" id="catalog-ice"></span></div>
<div class="topping-heading">Topping <small>Giá theo phần</small></div><div class="topping-options" id="catalog-toppings"></div>
<label class="field compact">Ghi chú pha chế<textarea rows="2" placeholder="Ghi chú thêm cho món"></textarea></label>
<div class="add-row"><div class="quantity"><button data-qty="-1" aria-label="Giảm số lượng">−</button><output id="quantity">1</output><button data-qty="1" aria-label="Tăng số lượng">+</button></div><button class="button primary" disabled title="Chức năng giỏ hàng sẽ được tích hợp trong UC đặt món">＋ Thêm vào giỏ</button></div>
</section>
