@{
    // Chỉ hiển thị vị trí trong luồng; không xác nhận đơn hay thay đổi trạng thái thanh toán.
    var screen = ViewData["CommerceClass"]?.ToString() ?? "";
    var step = screen.Contains("cart-screen") ? 1 : screen.Contains("checkout-screen") ? 2 : 3;
}
<ol class="commerce-steps checkout-path" aria-label="Các bước đặt món">
    <li class="@(step == 1 ? "current" : "done")" aria-current="@(step == 1 ? "step" : null)"><a href="/Cart"><span>01</span><strong>Giỏ hàng</strong></a></li>
    <li class="@(step == 2 ? "current" : step > 2 ? "done" : "")" aria-current="@(step == 2 ? "step" : null)"><a href="/Checkout"><span>02</span><strong>Thông tin nhận món</strong></a></li>
    <li class="@(step == 3 ? "current" : "")" aria-current="@(step == 3 ? "step" : null)"><span>03</span><strong>Thanh toán</strong></li>
</ol>
