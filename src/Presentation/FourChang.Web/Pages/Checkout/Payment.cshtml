@page
@model FourChang.Web.Pages.Checkout.PaymentModel
@using FourChang.Web.Services
@{ ViewData["Title"] = "Thanh toán đơn hàng"; }
<a asp-page="/Orders/Index" asp-route-PageNumber="@Model.ReturnPage" asp-route-Status="@Model.ReturnStatus"
   asp-route-FromUtc="@(Model.ReturnFromUtc?.ToString("O"))" asp-route-ToUtc="@(Model.ReturnToUtc?.ToString("O"))">Đơn hàng của tôi</a>
<section class="panel payment-panel">
    <p id="order-snapshot-connection" role="status" hidden></p>
    <h1>Thanh toán đơn hàng</h1>
    @if (Model.Error is not null) { <p role="alert">@Model.Error</p> }
    @if (Model.Detail is { } order)
    {
        <div data-order-private>
        <h2>@order.Order.Code</h2>
        <p>Trạng thái đơn: <strong>@order.Order.Status</strong></p>
        <p>Tổng hiện tại: @order.CurrentTotal.ToString("N0") đ · Đã xác minh thu: @order.Collected.ToString("N0") đ · Đã chi hoàn: @order.Refunded.ToString("N0") đ</p>
        @if (order.Order.Status == "EXPIRED") {
            <p role="status">Đơn đã hết hạn. Không chuyển khoản; nghĩa vụ thu/hoàn cần đối soát riêng với giao dịch thực nhận.</p>
        } else { <p>Còn thu theo số dư: <strong>@order.Remaining.ToString("N0") đ</strong></p> }
        <p>Hạn đơn UTC: @(order.ExpiresUtc?.ToString("u") ?? "Backend chưa cung cấp")</p>
        @if (order.Payments.Count == 0) { <p>Chưa có yêu cầu thanh toán. Trang này không tự tạo yêu cầu mới.</p> }
        @foreach (var payment in order.Payments)
        {
            <article>
                <h3>@payment.Code · @payment.Status</h3>
                <p>Yêu cầu: @payment.Requested.ToString("N0") đ · Đã xác minh: @payment.Verified.ToString("N0") đ</p>
                <p>Tham chiếu: @(payment.Reference ?? "Chưa có tham chiếu từ Backend")</p>
                <p>Hạn UTC: @(payment.ExpiresUtc?.ToString("u") ?? "Chưa có") · Xác minh UTC: @(payment.VerifiedUtc?.ToString("u") ?? "Chưa có")</p>
                <p role="status">@CustomerOrderPresentation.PaymentMessage(payment, DateTime.UtcNow)</p>
            </article>
        }
        @if (Model.Qr is { } qr) {
            <img src="@qr.PngDataUri" data-payment-qr data-qr-expires-utc="@qr.ExpiresUtc.ToString("O", System.Globalization.CultureInfo.InvariantCulture)" alt="VietQR từ nguồn đã kiểm tra thụ hưởng, số tiền và tham chiếu" width="260" height="260" />
        } else {
            <p class="notice">Chưa hỗ trợ VietQR đã được xác minh từ nhà cung cấp/cấu hình tin cậy. Không có mã QR để thanh toán trên trang này.</p>
        }
        <p id="payment-qr-expiry" class="notice" role="status" hidden></p>
        <p class="fine-print">Snapshot UTC: @order.SnapshotUtc.ToString("u"). Tải lại chỉ đọc trạng thái; không tự xác nhận PAID, không yêu cầu chuyển lại khi chưa rõ kết quả.</p>
        <a class="button primary" href="@(Request.Path + Request.QueryString)">Tải lại trạng thái</a>
        <a class="button secondary" asp-page="/Orders/Details" asp-route-orderId="@order.Order.Id"
           asp-route-ReturnPage="@Model.ReturnPage" asp-route-ReturnStatus="@Model.ReturnStatus"
           asp-route-ReturnFromUtc="@(Model.ReturnFromUtc?.ToString("O"))" asp-route-ReturnToUtc="@(Model.ReturnToUtc?.ToString("O"))">Chi tiết đơn</a>
        </div>
    }
</section>
@section Scripts { <script src="~/js/order-snapshot.js" asp-append-version="true"></script> }
