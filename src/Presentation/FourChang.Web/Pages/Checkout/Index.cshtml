@page "/Checkout"
@model FourChang.Web.Pages.Checkout.IndexModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostingEnvironment
@{
    ViewData["Title"] = "Đặt món";
}

<div class="breadcrumb"><a href="/Cart">Giỏ hàng</a> / Thông tin nhận hàng</div>
<div class="page-heading">
    <div>
        <span class="eyebrow">UC-WEB-06 · ĐẶT MANG ĐI</span>
        <h1>Nhận món theo cách của bạn</h1>
        <p class="muted">Kiểm tra thông tin và tổng tiền trước khi đặt mang đi. Đơn tạo thành công sẽ chờ thanh toán chuyển khoản.</p>
    </div>
</div>

<div class="two-columns">
    <section class="panel">
        <div class="tabs" data-tabs>
            <button type="button" data-tab="dinein">⌗ Tại bàn · Chưa mở</button>
            <button type="button" class="selected" data-tab="takeaway">♧ Mang đi</button>
            <button type="button" data-tab="delivery">⌁ Giao tận nơi · Chưa mở</button>
        </div>

        <div class="tab-panel" id="dinein" hidden>
            <div class="notice" role="status">Đặt tại bàn đang khóa. Cần token QR do quán cấp và kiểm chứng phiên bản, thu hồi, thời hạn trên máy chủ khi quét và khi gửi. QR bàn không phải QR thanh toán.</div>
            <p>Chưa có bàn được xác minh. Quét lại QR hợp lệ hoặc liên hệ nhân viên. Giỏ và thao tác đang chờ được giữ nguyên; không nhập mã bàn để bỏ qua xác minh.</p>
        </div>

        <div class="tab-panel" id="takeaway">
            <div class="field-grid">
                <label class="field">Người nhận <input id="takeaway-name" maxlength="120" required autocomplete="name" placeholder="Họ và tên người nhận" /></label>
                <label class="field">Số điện thoại <input id="takeaway-phone" type="tel" maxlength="16" required autocomplete="tel" placeholder="9–15 chữ số, có thể bắt đầu bằng +" /></label>
                <label class="field">Giờ nhận <input value="Nhận sớm nhất" readonly /></label>
                <label class="field">Điểm lấy món <input value="Quầy 4CHANG LINH NGU LAM" readonly /></label>
            </div>
            <p class="success-note">Mang đi: phí giao hàng 0đ.</p>
            <label class="inline-label" style="margin-top:25px">
                <input type="checkbox" id="checkout-confirmed" />
                Tôi chấp thuận thông tin nhận mang đi và tổng tiền Backend báo ở bên cạnh.
            </label>
        </div>

        <div class="tab-panel" id="delivery" hidden>
            <fieldset disabled class="field-grid">
                <label class="field">Người nhận <input placeholder="Họ và tên người nhận" /></label>
                <label class="field">Điện thoại <input type="tel" placeholder="Số điện thoại" /></label>
                <label class="field wide">Địa chỉ giao hàng <input placeholder="Địa chỉ giao hàng" /></label>
                <label class="field wide">Ghi chú giao hàng <textarea rows="2" placeholder="Tòa nhà, cổng vào, hướng dẫn liên hệ…"></textarea></label>
            </fieldset>
            <div class="notice" role="status">Đặt giao hàng đang khóa. Cần xác minh điểm giao, khoảng cách tuyến đường và chính sách phí được phê duyệt. Chưa có báo phí hợp lệ; không dùng khoảng cách hoặc phí mẫu. Không hỗ trợ COD.</div>
        </div>

    </section>

    <aside class="panel">
        <h3>Giỏ hàng của bạn</h3>
        <p id="checkout-cart-count" class="muted" role="status">Đang đọc giỏ nháp...</p>
        <dl class="totals" id="checkout-items"></dl>
        <dl class="totals">
            <div><dt>Tạm tính giá cơ sở</dt><dd id="checkout-base-subtotal">—</dd></div>
            <div><dt>Phí giao hàng</dt><dd id="shipping-fee">Chưa báo giá</dd></div>
            <div class="total"><dt>Thành tiền chính thức</dt><dd id="checkout-total">Chờ Backend</dd></div>
        </dl>
        <p class="fine-print" id="checkout-price-warning" role="status">
            Giá cuối cùng cần được Backend xác nhận, bao gồm topping và phí giao hàng.
        </p>

        <p id="checkout-disabled" class="notice" hidden="@Model.OrderCreationEnabled">Tạo đơn đang tắt theo cấu hình vận hành. Bạn vẫn có thể xem giỏ và nhận báo giá chính thức. Đăng nhập không tự mở quyền tạo đơn; thao tác đang chờ được giữ nguyên.</p>
        @if (FourChang.Web.Pages.Checkout.DemoQrModel.IsPreviewEnabled(Configuration["Demo:PaymentQrEnabled"], HostingEnvironment.EnvironmentName))
        {
            <p class="fine-print" role="note"><a id="checkout-demo-preview" href="/Checkout/DemoQr">Xem QR mô phỏng UC07 — không phải thanh toán cho giỏ hiện tại</a></p>
        }
        <button type="button" id="checkout-proceed" class="button primary full" disabled
                data-order-creation-enabled="@(Model.OrderCreationEnabled ? "true" : "false")"
                data-customer-id="@Model.CustomerId" data-owner-proof="@Model.OwnerProof">
            Đặt mang đi
        </button>
        <p id="checkout-order-status" role="status" aria-live="polite"></p>
        <p id="checkout-pending-details" class="notice" hidden></p>
        <section id="checkout-receipt" hidden aria-live="polite">
            <h3>Đã tạo đơn chờ thanh toán</h3>
            <dl class="totals">
                <div><dt>Mã đơn</dt><dd id="receipt-code"></dd></div>
                <div><dt>Tổng tiền</dt><dd id="receipt-total"></dd></div>
                <div><dt>Trạng thái khi tạo</dt><dd>PENDING_PAYMENT</dd></div>
                <div><dt>Hạn thanh toán</dt><dd id="receipt-deadline"></dd></div>
            </dl>
            <a id="checkout-receipt-payment" class="button primary full" href="/Orders">Xem thanh toán đơn vừa tạo (UC-WEB-07)</a>
            <a class="button secondary full" href="/Orders">Theo dõi trạng thái hiện tại</a>
            <button id="checkout-new-order" type="button" class="button secondary full">Bắt đầu đơn tiếp theo</button>
        </section>
        <a id="checkout-login" href="/Account/Login" hidden>Đăng nhập Customer rồi quay lại Checkout để thử lại</a>
        <details>
            <summary>Thao tác đang chờ và thông tin trên máy dùng chung</summary>
            <p>Để thử lại đúng đơn khi mất phản hồi, trình duyệt lưu tên, số điện thoại, giỏ và mã thao tác trên máy này. Đóng tab hoặc đăng xuất không xóa dữ liệu đó; người dùng cùng hồ sơ trình duyệt có thể đọc được.</p>
            <p>Khi chưa rõ kết quả, không xóa dữ liệu trang, đổi mã thao tác hoặc đặt lại trên thiết bị khác. Quay lại cùng trình duyệt, cùng địa chỉ website, đăng nhập đúng tài khoản và chỉ thử lại thao tác cũ khi chức năng được mở; nếu bị khóa, liên hệ người vận hành để đối soát.</p>
            <p>Trên máy dùng chung, nên dùng hồ sơ trình duyệt riêng. Nếu còn thao tác chờ, giữ hồ sơ đó được bảo vệ cho tới khi có kết quả. Sau biên nhận hợp lệ, nút “Bắt đầu đơn tiếp theo” xóa bản thao tác đã lưu; hãy kiểm tra giỏ còn lại và đăng xuất trước khi bàn giao máy.</p>
        </details>
        <p class="fine-print">Chỉ nhận sớm nhất; chưa hỗ trợ hẹn giờ. VietQR thật chưa được tích hợp tại bước này. Chưa xác minh tiền và chưa tiếp nhận pha chế.</p>
        <a class="text-button" href="/Cart">Quay lại chỉnh sửa giỏ hàng</a>
    </aside>
</div>

<div id="checkout-quote-antiforgery" hidden>@Html.AntiForgeryToken()</div>

@section Scripts {
    <script src="~/js/checkout-cart.js" asp-append-version="true"></script>
    <script src="~/js/checkout-quote.js" asp-append-version="true"></script>
    <script src="~/js/checkout-order.js" asp-append-version="true"></script>
    <script src="~/js/demo-qr-navigation.js" asp-append-version="true"></script>
}
