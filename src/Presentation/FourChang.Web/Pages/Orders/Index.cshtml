
@page "/Orders"
@model FourChang.Web.Pages.Orders.IndexModel

@{
    ViewData["Title"] = "Đơn của tôi";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">UC-WEB-08</span>
        <h1>Đơn hàng của tôi</h1>
        <p class="muted">
            Theo dõi tiến trình xử lý đơn hàng của bạn.
        </p>
    </div>

    <a href="/" class="button primary">
        Xem thực đơn
    </a>
</div>

<section class="panel">

    <h2>Danh sách đơn hàng</h2>

    <p id="orders-refresh-status"
       class="muted"
       role="status">
        Đang kiểm tra trạng thái đơn hàng...
    </p>

    <div id="orders-list">

        @if (Model.Error is not null)
        {
            <p role="alert">@Model.Error</p>
        }
        else if (Model.Orders.Count == 0)
        {
            <div class="empty-state">
                <h3>Chưa có đơn hàng</h3>
                <p>
                    Các đơn hàng của bạn sẽ xuất hiện tại đây.
                </p>
                <a href="/" class="button secondary">
                    Chọn món ngay
                </a>
            </div>
        }
        else
        {
            foreach (var order in Model.Orders)
            {
                <article class="line-item">
                    <div class="item-content">
                        <h3>
                            Đơn hàng
                            @(order.GetProperty("maDonHienThi").GetString())
                        </h3>

                        <p>
                            Trạng thái:
                            <strong>
                                @(order.GetProperty("trangThai").GetString())
                            </strong>
                        </p>
                    </div>
                </article>
            }
        }

    </div>

    <p class="fine-print">
        Trạng thái được đồng bộ định kỳ từ hệ thống.
        Việc xác nhận thanh toán và hủy đơn
        phải được xử lý tại Backend.
    </p>

</section>

@section Scripts {
<script>
(() => {
    "use strict";

    const list = document.getElementById("orders-list");
    const status = document.getElementById(
        "orders-refresh-status"
    );

    if (!list || !status) return;

    let loading = false;
    let stopped = false;

    function createText(tag, value, className = "") {
        const element = document.createElement(tag);

        element.textContent = value;

        if (className) {
            element.className = className;
        }

        return element;
    }

    function renderOrders(orders) {
        const fragment = document.createDocumentFragment();

        if (orders.length === 0) {
            const empty = document.createElement("div");
            empty.className = "empty-state";

            empty.append(
                createText("h3", "Chưa có đơn hàng"),
                createText(
                    "p",
                    "Các đơn hàng của bạn sẽ xuất hiện tại đây."
                )
            );

            fragment.append(empty);
        }

        orders.forEach(order => {
            const article = document.createElement("article");
            article.className = "line-item";

            const content = document.createElement("div");
            content.className = "item-content";

            const orderCode =
                order.maDonHienThi ||
                order.maDonHang ||
                "Chưa có mã";

            content.append(
                createText(
                    "h3",
                    "Đơn hàng " + orderCode
                ),
                createText(
                    "p",
                    "Trạng thái: " +
                    (order.trangThai || "Chưa xác định")
                ),
                createText(
                    "p",
                    "Hình thức nhận: " +
                    (order.hinhThucNhanMon || "Chưa xác định"),
                    "muted"
                )
            );

            article.append(content);
            fragment.append(article);
        });

        // Thay thế danh sách cũ, không tạo đơn trùng.
        list.replaceChildren(fragment);
    }

    async function refreshOrders() {
        if (loading || stopped || document.hidden) return;

        loading = true;

        try {
            const response = await fetch(
                "/Orders?handler=Status",
                {
                    credentials: "same-origin",
                    cache: "no-store",
                    headers: {
                        Accept: "application/json"
                    }
                }
            );

            if (response.status === 401 ||
                response.status === 403) {
                stopped = true;

                status.textContent =
                    "Phiên đăng nhập đã hết hạn. " +
                    "Vui lòng đăng nhập lại.";

                return;
            }

            if (!response.ok) {
                throw new Error(
                    "HTTP " + response.status
                );
            }

            const orders = await response.json();

            if (!Array.isArray(orders)) {
                throw new Error("Dữ liệu không hợp lệ.");
            }

            renderOrders(orders);

            status.textContent =
                "Cập nhật lúc " +
                new Date().toLocaleTimeString("vi-VN") +
                " · Tự động kiểm tra mỗi 15 giây";

        } catch (error) {
            console.error(
                "Không thể cập nhật đơn hàng:",
                error
            );

            status.textContent =
                "Không thể cập nhật trạng thái. " +
                "Đang giữ dữ liệu lần gần nhất.";
        } finally {
            loading = false;
        }
    }

    // Tải trạng thái khi mở trang.
    refreshOrders();

    // Cập nhật định kỳ.
    const timer = setInterval(refreshOrders, 15000);

    // Khi quay lại tab trình duyệt.
    document.addEventListener(
        "visibilitychange",
        () => {
            if (!document.hidden) {
                refreshOrders();
            }
        }
    );

    // Dừng kiểm tra khi rời trang.
    window.addEventListener(
        "pagehide",
        () => clearInterval(timer),
        { once: true }
    );
})();
</script>
}
