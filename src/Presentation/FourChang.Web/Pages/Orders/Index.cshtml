@page "/Orders"
@model FourChang.Web.Pages.Orders.IndexModel
@using FourChang.Presentation.Shared.Contracts.Customer
@{ ViewData["Title"] = "Đơn hàng của tôi"; }
<div class="page-heading"><h1>Đơn hàng của tôi</h1><a href="/" class="button secondary">Thực đơn</a></div>
<section class="panel">
    <p id="order-snapshot-connection" role="status" hidden></p>
    <form method="get" asp-page="/Orders/Index">
        <label>Trạng thái <select asp-for="Status"><option value="">Tất cả</option>
            @foreach (var state in CustomerOrderStates.Orders) { <option value="@state">@state</option> }
            @if (Model.ExpiryReadEnabled) { <option value="EXPIRED">EXPIRED</option> }
        </select></label>
        <label>Từ thời điểm (UTC) <input asp-for="FromUtc" type="datetime-local" /></label>
        <label>Đến trước thời điểm (UTC) <input asp-for="ToUtc" type="datetime-local" /></label>
        <button class="button primary" type="submit">Lọc / Tải lại</button>
        <a asp-page="/Orders/Index">Bỏ lọc</a>
    </form>
    <p class="muted">Snapshot tại thời điểm tải, không cập nhật trực tiếp. Bấm tải lại để xem trạng thái mới; mở lại trang không tạo giao dịch.</p>
    @if (Model.Error is not null) { <p role="alert">@Model.Error</p> }
    @if (Model.Snapshot is { } snapshot)
    {
        <div data-order-private>
        <p role="status">Cập nhật UTC: @snapshot.SnapshotUtc.ToString("u") · @snapshot.TotalCount đơn phù hợp</p>
        @if (snapshot.Items.Count == 0) { <p>Chưa có đơn phù hợp với bộ lọc.</p> }
        @foreach (var order in snapshot.Items)
        {
            <article class="line-item"><div>
                <h2><a asp-page="/Orders/Details" asp-route-orderId="@order.Id" asp-route-ReturnPage="@Model.PageNumber"
                       asp-route-ReturnStatus="@Model.Status" asp-route-ReturnFromUtc="@(Model.FromUtc?.ToString("O"))"
                       asp-route-ReturnToUtc="@(Model.ToUtc?.ToString("O"))">@order.Code</a></h2>
                <p>@order.Status · @order.Fulfilment</p>
                <p>Tạo UTC: @order.CreatedUtc.ToString("u") · Cập nhật UTC: @order.UpdatedUtc.ToString("u")</p>
            </div></article>
        }
        <nav aria-label="Phân trang đơn hàng">
            @if (snapshot.Page > 1) {
                <a asp-page="/Orders/Index" asp-route-PageNumber="@(snapshot.Page - 1)" asp-route-Status="@Model.Status"
                   asp-route-FromUtc="@(Model.FromUtc?.ToString("O"))" asp-route-ToUtc="@(Model.ToUtc?.ToString("O"))">Trang trước</a>
            }
            <span>Trang @snapshot.Page</span>
            @if ((long)snapshot.Page * snapshot.PageSize < snapshot.TotalCount) {
                <a asp-page="/Orders/Index" asp-route-PageNumber="@(snapshot.Page + 1)" asp-route-Status="@Model.Status"
                   asp-route-FromUtc="@(Model.FromUtc?.ToString("O"))" asp-route-ToUtc="@(Model.ToUtc?.ToString("O"))">Trang sau</a>
            }
        </nav>
        </div>
    }
</section>
@section Scripts { <script src="~/js/order-snapshot.js" asp-append-version="true"></script> }
