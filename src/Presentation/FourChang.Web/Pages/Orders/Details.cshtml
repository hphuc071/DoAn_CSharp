
@page "/Orders/{orderId:long}"
@model FourChang.Web.Pages.Orders.DetailsModel

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var order = Model.Detail;
}

<a asp-page="/Orders/Index"
   asp-route-PageNumber="@Model.ReturnPage"
   asp-route-Status="@Model.ReturnStatus"
   asp-route-FromUtc="@(Model.ReturnFromUtc?.ToString("O"))"
   asp-route-ToUtc="@(Model.ReturnToUtc?.ToString("O"))">
    Đơn hàng của tôi
</a>

<section class="panel">
    <p id="order-snapshot-connection" role="status" hidden></p>

    <h1>Chi tiết đơn hàng</h1>

    @if (TempData["CancelMessage"] is string message)
    {
        <p role="status">@message</p>
    }

    @if (Model.Error is not null)
    {
        <p role="alert">@Model.Error</p>
    }

    @if (order is not null)
    {
        <div data-order-private>
            <h2>@order.Order.Code · @order.Order.Status</h2>

            <p>
                @order.Order.Fulfilment ·
                Tạo UTC: @order.Order.CreatedUtc.ToString("u")
            </p>

            <p>
                Tiếp nhận UTC:
                @(order.AcceptedUtc?.ToString("u") ?? "Chưa có")
                · Hoàn tất UTC:
                @(order.CompletedUtc?.ToString("u") ?? "Chưa có")
            </p>

            <p role="status">
                Snapshot UTC @order.SnapshotUtc.ToString("u").
                Dữ liệu có thể đã thay đổi; tải lại để cập nhật.
            </p>

            <a class="button secondary"
               href="@(Request.Path + Request.QueryString)">
                Tải lại trạng thái
            </a>

            <a class="button primary"
               asp-page="/Checkout/Payment"
               asp-route-orderId="@order.Order.Id"
               asp-route-ReturnPage="@Model.ReturnPage"
               asp-route-ReturnStatus="@Model.ReturnStatus"
               asp-route-ReturnFromUtc="@(Model.ReturnFromUtc?.ToString("O"))"
               asp-route-ReturnToUtc="@(Model.ReturnToUtc?.ToString("O"))">
                Xem thanh toán
            </a>

            @foreach (var line in order.Lines)
            {
                <article class="line-item">
                    <div>
                        <h3>
                            @line.Name · @line.Size · @line.Temperature
                        </h3>

                        <p>
                            Đường @line.Sugar% ·
                            Đá @line.Ice% ·
                            @line.Note
                        </p>

                        <p>
                            Đặt: @line.Quantity ·
                            Đã hủy: @line.Cancelled ·
                            Bắt đầu pha: @line.Started ·
                            Pha xong: @line.Prepared
                        </p>

                        @foreach (var topping in line.Toppings)
                        {
                            <p>
                                @topping.Name:
                                @topping.Portions phần/ly ×
                                @topping.Price.ToString("N0") đ
                            </p>
                        }

                        <p>
                            Đơn giá đã chốt:
                            @line.UnitPrice.ToString("N0") đ ·
                            Thành tiền còn lại:
                            @line.CurrentTotal.ToString("N0") đ
                        </p>
                    </div>
                </article>
            }

            <dl>
                <dt>Phí giao đã chốt ban đầu / hiện tại</dt>
                <dd>
                    @order.OriginalShippingFee.ToString("N0") /
                    @order.ShippingFee.ToString("N0") đ
                </dd>

                <dt>Tổng ban đầu / hiện tại</dt>
                <dd>
                    @order.OriginalTotal.ToString("N0") /
                    @order.CurrentTotal.ToString("N0") đ
                </dd>

                <dt>Đã xác minh thu / Đã chi hoàn thành công</dt>
                <dd>
                    @order.Collected.ToString("N0") /
                    @order.Refunded.ToString("N0") đ
                </dd>

                @if (order.Order.Status == "EXPIRED")
                {
                    <dt>Đơn hết hạn</dt>
                    <dd>
                        Không chuyển khoản. Cần đối soát nghĩa vụ
                        theo thu/hoàn thực tế; không dùng tổng
                        snapshot làm khoản cần chuyển.
                    </dd>
                }
                else
                {
                    <dt>Còn thu / Nghĩa vụ hoàn theo số dư</dt>
                    <dd>
                        @order.Remaining.ToString("N0") /
                        @order.RefundObligation.ToString("N0") đ
                    </dd>
                }
            </dl>

            <h2>Thanh toán</h2>

            @foreach (var payment in order.Payments)
            {
                <p>
                    @payment.Code · @payment.Status ·
                    Đã xác minh @payment.Verified.ToString("N0") đ
                </p>
            }

            <h2>Hoàn tiền</h2>

            @if (order.Refunds.Count == 0)
            {
                <p>Chưa có hồ sơ hoàn.</p>
            }

            @foreach (var refund in order.Refunds)
            {
                <p>
                    @refund.Code · @refund.Status ·
                    Yêu cầu @refund.Requested.ToString("N0") đ ·
                    Duyệt
                    @(refund.Approved?.ToString("N0") ?? "Chưa có") đ ·
                    Đã chi thành công
                    @refund.SuccessfullyDisbursed.ToString("N0") đ
                </p>
            }

            <h2>Hóa đơn</h2>

            @if (order.Invoices.Count == 0)
            {
                <p>Chưa có hóa đơn.</p>
            }

            @foreach (var invoice in order.Invoices)
            {
                <p>
                    @invoice.Number ·
                    @invoice.Kind ·
                    @invoice.Status ·
                    @invoice.Amount.ToString("N0") đ ·
                    Phát hành UTC:
                    @(invoice.IssuedUtc?.ToString("u") ?? "Chưa phát hành")
                </p>

                @if (invoice.Status == "ISSUED" &&
                     invoice.IssuedUtc is not null)
                {
                    <a asp-page-handler="Invoice"
                       asp-route-orderId="@order.Order.Id"
                       asp-route-invoiceId="@invoice.Id"
                       data-online-only>
                        Tải PDF đã lưu (nếu có)
                    </a>
                }
            }

            <p>
                Nguồn lưu PDF hiện chưa tích hợp; không có tệp
                thì không tạo hoặc phát hành hóa đơn mới.
                Trạng thái duyệt hoàn không có nghĩa đã chi tiền.
            </p>

            @if (order.CancellationEligible)
            {
                <h2>Yêu cầu hủy toàn đơn</h2>

                <p>
                    Số đã thu chưa hoàn để đối soát khi hủy:
                    @(Math.Max(
                        0m,
                        order.Collected - order.Refunded
                    ).ToString("N0")) đ.
                    Chưa phải cam kết chi hoàn.
                </p>

                <form method="post"
                      asp-page-handler="Cancel"
                      asp-antiforgery="true">

                    <input type="hidden" name="orderId" value="@order.Order.Id" />
                    <input type="hidden" name="expectedVersion" value="@order.Version" />
                    <input type="hidden" name="operationId" value="@Guid.NewGuid()" />

                    <label for="cancel-reason">
                        Lý do hủy đơn (3–400 ký tự)
                    </label>

                    <textarea id="cancel-reason"
                              name="reason"
                              required
                              minlength="3"
                              maxlength="400"></textarea>

                    @if (Model.CustomerCancellationWebEnabled)
                    {
                        <button type="submit"
                                class="button secondary">
                            Xác nhận hủy đơn
                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="button secondary"
                                disabled>
                            Yêu cầu hủy đang khóa
                        </button>

                        <p role="status">
                            Chức năng hủy trực tuyến chưa được mở.
                            Cần hoàn tất nghiệm thu giao dịch SQL,
                            giải phóng nguyên liệu và nghĩa vụ hoàn tiền.
                        </p>
                    }
                </form>
            }
        </div>
    }
</section>

@section Scripts
{
    <script src="~/js/order-snapshot.js"
            asp-append-version="true"></script>
}
