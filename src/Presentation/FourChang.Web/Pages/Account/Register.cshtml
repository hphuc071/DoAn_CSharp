@page
@model FourChang.Web.Pages.Account.RegisterModel
@{ViewData["Title"]="Đăng ký";}
<div class="auth-layout auth-layout-v3">
    <section class="auth-visual">
        <span class="eyebrow">CHÀO MỪNG ĐẾN VỚI 4CHANG</span>
        <img class="auth-brand-mark" src="~/assets/brand-mark.svg" alt="Logo 4CHANG LINH NGU LAM" width="160" height="160" asp-append-version="true"/>
        <div class="auth-wordmark">4CHANG<span>LINH NGU LAM</span></div>
        <h1>Hẹn bạn một ly<br/>cà phê thật ngon.</h1>
        <p>Hồ sơ của bạn, khẩu vị của bạn.</p>
    </section>
    <section class="auth-form">
        <h1>Tạo tài khoản</h1>
        <form method="post">
            <input asp-for="MaThaoTac" type="hidden"/>
            <div asp-validation-summary="All" role="alert"></div>
            <label class="field">Họ tên<input asp-for="HoTen" autocomplete="name" maxlength="120" required/></label>
            <label class="field">Tên đăng nhập<input asp-for="TenDangNhap" autocomplete="username" minlength="3" maxlength="100" required/></label>
            <label class="field">Số điện thoại<input asp-for="SoDienThoai" type="tel" autocomplete="tel" placeholder="VD: 0912345678" maxlength="10" pattern="[0-9]{10}" inputmode="numeric" required/></label>
            <label class="field">Email<input asp-for="Email" type="email" autocomplete="email" placeholder="Tùy chọn" maxlength="254"/></label>
            <p class="muted">Số điện thoại bắt buộc đủ 10 chữ số. Email tùy chọn; mật khẩu tối thiểu 5 ký tự.</p>
            <label class="field">Mật khẩu<input asp-for="MatKhau" type="password" autocomplete="new-password" minlength="5" maxlength="128" required/></label>
            <label class="field">Xác nhận mật khẩu<input asp-for="XacNhanMatKhau" type="password" autocomplete="new-password" minlength="5" maxlength="128" required/></label>
            <button class="button primary full">Tạo tài khoản</button>
        </form>
        <a href="/" class="button secondary">Hủy đăng ký</a>
        <p>Đã có tài khoản? <a href="/Account/Login"><strong>Đăng nhập</strong></a></p>
    </section>
</div>
