@page
@model FourChang.Web.Pages.Account.RegisterModel
@{ViewData["Title"]="Đăng ký";}
<div class="auth-layout auth-layout-v3"><section class="auth-visual"><span class="eyebrow">CHÀO MỪNG ĐẾN VỚI 4CHANG</span><img class="auth-brand-mark" src="~/assets/brand-mark.svg" alt="Logo 4CHANG LINH NGU LAM" width="160" height="160" asp-append-version="true"/><div class="auth-wordmark">4CHANG<span>LINH NGU LAM</span></div><h1>Hẹn bạn một ly<br/>cà phê thật ngon.</h1><p>Hồ sơ của bạn, khẩu vị của bạn.</p></section><section class="auth-form"><h1>Tạo tài khoản</h1><form method="post"><input asp-for="MaThaoTac" type="hidden"/><div asp-validation-summary="All" role="alert"></div><div class="field-grid"><label class="field">Họ tên<input asp-for="HoTen" autocomplete="name" required/><span asp-validation-for="HoTen" class="field-error"></span></label><label class="field">Tên đăng nhập<input asp-for="TenDangNhap" autocomplete="username" minlength="3" required/><span asp-validation-for="TenDangNhap" class="field-error"></span></label><label class="field">Email<input asp-for="Email" type="email" autocomplete="email"/><span asp-validation-for="Email" class="field-error"></span></label><label class="field">Số điện thoại<input asp-for="SoDienThoai" type="tel" autocomplete="tel"/><span asp-validation-for="SoDienThoai" class="field-error"></span></label></div><p>Cần ít nhất email hoặc số điện thoại.</p><label class="field">Mật khẩu<input asp-for="MatKhau" type="password" autocomplete="new-password" minlength="10" required/><span asp-validation-for="MatKhau" class="field-error"></span></label><label class="field">Xác nhận mật khẩu<input asp-for="XacNhanMatKhau" type="password" autocomplete="new-password" required/><span asp-validation-for="XacNhanMatKhau" class="field-error"></span></label><button class="button primary full">Tạo tài khoản</button></form><a href="/" class="button secondary">Hủy đăng ký</a><p>Đã có tài khoản? <a href="/Account/Login"><strong>Đăng nhập</strong></a></p></section></div>
