@page
@model FourChang.Web.Pages.Account.ChangeTemporaryPasswordModel
@{ ViewData["Title"] = "Đổi mật khẩu tạm"; }
<div class="auth-layout auth-layout-v3">
    <section class="auth-visual"><span class="eyebrow">4CHANG LINH NGU LAM</span><img class="auth-brand-mark" src="~/assets/brand-mark.svg" alt="Logo 4CHANG LINH NGU LAM" width="160" height="160" asp-append-version="true"/><div class="auth-wordmark">4CHANG<span>LINH NGU LAM</span></div><h1>Mật khẩu của bạn,<br/>do bạn giữ.</h1></section>
    <section class="auth-form">
        <h1>Đổi mật khẩu tạm</h1>
        <p>Đặt mật khẩu riêng trước khi sử dụng tài khoản. Sau khi lưu, bạn cần đăng nhập lại.</p>
        <form method="post"><input asp-for="MaThaoTac" type="hidden"/><input asp-for="PhienBan" type="hidden"/><input asp-for="ChuaRoKetQua" type="hidden"/>
            <div asp-validation-summary="All" role="alert"></div>
            <label class="field">Mật khẩu mới<input asp-for="MatKhauMoi" type="password" autocomplete="new-password" minlength="5" maxlength="128" required /></label>
            <label class="field">Xác nhận mật khẩu mới<input asp-for="XacNhanMatKhau" type="password" autocomplete="new-password" minlength="5" maxlength="128" required /></label>
            <button class="button primary full" formnovalidate="@Model.ChuaRoKetQua">@(Model.ChuaRoKetQua?"Kiểm tra / thử lại":"Lưu mật khẩu mới")</button>
        </form>
        <a href="/Account/Login">Quay lại đăng nhập</a>
    </section>
</div>
