
@page "/Cart"
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="breadcrumb">
    <a href="/">Thực đơn</a> / Giỏ hàng
</div>

<div class="page-heading">
    <div>
        <span class="eyebrow">UC-WEB-05</span>
        <h1>Giỏ hàng của bạn</h1>
        <span class="muted" id="cart-count">Đang tải giỏ...</span>
    </div>
    <a class="button secondary" href="/">
        ＋ Chọn thêm món
    </a>
</div>

<div class="two-columns">
    <section class="panel">

        <div id="cart-empty" hidden>
            <h3>Giỏ hàng đang trống</h3>
            <p>Bạn chưa thêm món nào vào giỏ.</p>
            <a class="button secondary" href="/">
                Xem thực đơn
            </a>
        </div>

        <div id="cart-lines"></div>

        <p class="reference-note">
            Giỏ hàng là bản nháp.
            Giá, topping, cấu hình và tình trạng
            nguyên liệu phải được API kiểm tra lại
            trước khi tạo đơn hàng.
        </p>

        <button type="button"
                class="text-button"
                id="clear-cart">
            Xóa toàn bộ giỏ nháp
        </button>

    </section>

    <aside class="panel">
        <h3>Tóm tắt giỏ hàng</h3>

        <dl class="totals">
            <div class="total">
                <dt>Giá cơ sở tham khảo</dt>
                <dd id="cart-base-total">—</dd>
            </div>
        </dl>

        <p class="fine-print">
            Giá trên chưa bao gồm các khoản chênh lệch
            size, topping hoặc phí giao hàng.
            Đây không phải số tiền thanh toán chính thức.
        </p>

        <a href="/Checkout"
           class="button secondary full">
            Xem màn hình đặt món (bản mẫu)
        </a>

        <p class="fine-print">
            Chưa thể gửi đơn thật cho đến khi
            hoàn thiện API kiểm tra giỏ và tạo đơn.
        </p>
    </aside>
</div>

@section Scripts {
    <script src="~/js/cart-page.js"
            asp-append-version="true"></script>
}
