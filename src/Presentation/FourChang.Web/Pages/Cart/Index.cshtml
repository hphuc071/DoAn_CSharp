
@page "/Cart"
@model FourChang.Web.Pages.Cart.IndexModel
@{ ViewData["CommerceClass"] = "commerce-page cart-screen";
    ViewData["Title"] = "Giỏ hàng";
}

<div class="breadcrumb">
    <a href="/">Thực đơn</a> / Giỏ hàng
</div>

<div class="page-heading">
    <div>
        <span class="eyebrow">MÓN NGON BẠN ĐÃ CHỌN</span>
        <h1>Giỏ hàng của bạn</h1>
        <span class="muted" id="cart-count">Đang tải giỏ...</span>
    </div>
    <a class="button secondary" href="/">
        Chọn thêm món
    </a>
</div>

<partial name="_CheckoutSteps"/>
<div class="two-columns commerce-columns">
    <section class="panel cart-main"><div class="commerce-section-heading"><h2>Món trong giỏ</h2><span class="muted">Tùy chỉnh theo khẩu vị của bạn</span></div>

        <div id="cart-empty" hidden>
            <h3>Giỏ hàng đang trống</h3>
            <p>Bạn chưa thêm món nào vào giỏ.</p>
            <a class="button secondary" href="/">
                Xem thực đơn
            </a>
        </div>

        <p id="cart-status" role="status"></p>
        <div id="cart-lines"></div>


        <p class="reference-note">
            Bạn có thể sửa món hoặc số lượng. Giá và tình trạng món sẽ được kiểm tra lại trước khi xác nhận đơn.
        </p>

        <button type="button"
                class="text-button"
                id="clear-cart">
            Xóa toàn bộ giỏ hàng
        </button>

    </section>

    <aside class="panel commerce-summary">
        <h3>TÓM TẮT GIỎ HÀNG</h3>

        <dl class="totals">
            <div class="total">
                <dt>Tạm tính món và topping</dt>
                <dd id="cart-base-total">—</dd>
            </div>
        </dl>

        <p class="fine-print">
Tạm tính gồm món và topping đã chọn. Kiểm tra giá cuối cùng ở bước đặt món.
        </p>

        <a href="/Checkout"
           class="button primary full">
            Thanh toán →
        </a>

        <p class="fine-print">
            Chọn hình thức nhận món tại bước thanh toán. Chuyển khoản trước khi quán tiếp nhận.
        </p>
    </aside>
</div>

<!-- Dùng lại bộ cấu hình hiện có; đóng cửa sổ không thay đổi dòng giỏ khi chưa lưu. -->
<dialog id="cart-edit-dialog" class="product-config-dialog" aria-label="Sửa món trong giỏ">
    <button type="button" class="config-close" aria-label="Đóng sửa món">×</button>
    <section id="cart-editor" class="customizer panel" aria-label="Sửa dòng giỏ" hidden></section>
</dialog>
@section Scripts {
    <script src="~/js/cart-draft.js" asp-append-version="true"></script>
    <script src="~/js/cart-editor.js" asp-append-version="true"></script>
    <script src="~/js/cart-page.js"
            asp-append-version="true"></script>
}
