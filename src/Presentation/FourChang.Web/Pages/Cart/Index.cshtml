
@page "/Cart"
@model FourChang.Web.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="breadcrumb">
    <a href="/">Thực đơn</a> / Giỏ hàng
</div>

<div class="page-heading">
    <div>
        <span class="eyebrow">UC-WEB-05</span>
        <h1>Giỏ hàng của bạn</h1>
        <span class="muted" id="cart-count">Đang tải giỏ...</span>
    </div>
    <a class="button secondary" href="/">
        ＋ Chọn thêm món
    </a>
</div>

<div class="two-columns">
    <section class="panel">

        <div id="cart-empty" hidden>
            <h3>Giỏ hàng đang trống</h3>
            <p>Bạn chưa thêm món nào vào giỏ.</p>
            <a class="button secondary" href="/">
                Xem thực đơn
            </a>
        </div>

        <p id="cart-status" role="status"></p>
        <div id="cart-lines"></div>
        <section id="cart-editor" class="panel" aria-label="Sửa dòng giỏ" hidden></section>

        <p class="reference-note">
            Giỏ hàng là bản nháp.
            Giá, topping, cấu hình và tình trạng
            nguyên liệu phải được API kiểm tra lại
            trước khi tạo đơn hàng.
        </p>

        <button type="button"
                class="text-button"
                id="clear-cart">
            Xóa toàn bộ giỏ nháp
        </button>

    </section>

    <aside class="panel">
        <h3>Tóm tắt giỏ hàng</h3>

        <dl class="totals">
            <div class="total">
                <dt>Tạm tính món và topping</dt>
                <dd id="cart-base-total">—</dd>
            </div>
        </dl>

        <p class="fine-print">
            Giá nháp từ cấu hình đã chọn, chưa gồm phí giao hàng. Giỏ cũ thiếu snapshot
            topping cần mở Sửa món để xác minh. Backend sẽ tính lại trước khi đặt.
        </p>

        <a href="/Checkout"
           class="button secondary full">
            Kiểm tra giá và tiếp tục Checkout
        </a>

        <p class="fine-print">
            Tạo đơn chịu kiểm soát của máy chủ; QR bàn và giao hàng vẫn khóa.
        </p>
    </aside>
</div>

@section Scripts {
    <script src="~/js/cart-draft.js" asp-append-version="true"></script>
    <script src="~/js/cart-editor.js" asp-append-version="true"></script>
    <script src="~/js/cart-page.js"
            asp-append-version="true"></script>
}
