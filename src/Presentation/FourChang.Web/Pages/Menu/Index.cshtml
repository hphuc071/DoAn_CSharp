@page "/"
@model FourChang.Web.Pages.Menu.IndexModel
@{ ViewData["Title"]="Thực đơn"; }
@if(Model.Error is not null){<div class="panel" role="alert">@Model.Error</div>}
<div class="menu-layout" id="catalog-live"><section><div class="hero" id="catalog-banner"><div><span class="eyebrow">CÀ PHÊ NGON MỖI NGÀY</span><h1>Một chút cà phê,<br/>một ngày dễ chịu.</h1><p>Cà phê ngon · Không gian ấm · Năng lượng tích cực</p><a class="button cream" href="#menu">Chọn món yêu thích ↗</a></div><div class="hero-cup drink-photo sprite-2"></div></div>
<div class="section-heading" id="menu"><div><span class="eyebrow">ĐƯỢC PHA BẰNG SỰ TẬN TÂM</span><h2>Hôm nay bạn uống gì?</h2></div><output id="menu-result-count" class="menu-result-count" aria-live="polite" aria-atomic="true">@Model.Products.Count món được chọn lọc</output></div>
<div class="search-box"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="menu-search" placeholder="Tìm món yêu thích…" aria-label="Tìm món"/><select id="price-filter" aria-label="Lọc giá"><option value="all">Mọi mức giá</option><option value="under">Dưới 45.000đ</option><option value="over">Từ 45.000đ</option></select></div>
<div class="menu-filters"><div class="pills" id="categories"><button class="selected" data-category="Tất cả">Tất cả</button><button data-category="Cà phê">Cà phê</button><button data-category="Trà">Trà</button><button data-category="Đá xay">Đá xay</button></div><select id="stock-filter" aria-label="Lọc trạng thái"><option value="all">Mọi trạng thái</option><option value="available">Còn hàng</option><option value="unavailable">Tạm hết</option></select><select id="menu-sort" aria-label="Sắp xếp"><option value="default">Đề xuất</option><option value="asc">Giá tăng dần</option><option value="desc">Giá giảm dần</option></select></div>
<div class="product-grid" id="product-grid">@foreach(var item in Model.Products){<article class="product-card @(!item.Available?"sold-out":"")" data-available="@(item.Available?"true":"false")" data-name="@item.Name" data-category="@item.Category" data-price="@item.Price"><div class="drink-photo sprite-@item.ImageIndex" role="img" aria-label="@item.Name"></div>@if(item.Badge!=""){<span class="product-badge @(!item.Available?"gray":"")">@item.Badge</span>}<div class="product-info"><div><h3>@item.Name</h3><strong>@MoneyDisplay.Format(item.Price)</strong>@if(!item.Available){<br/><span class="status gray">Tạm hết hàng</span>}</div><button class="round-add" disabled="@(!item.Available)" data-menu-id="@item.MaMon" data-product="@item.Name" data-price="@item.Price" data-image="@item.ImageIndex" aria-label="Chọn @item.Name">+</button></div></article>}</div>
<div class="empty-state" id="menu-empty" hidden><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><h3>Chưa tìm thấy món phù hợp</h3><p>Thử từ khóa khác hoặc bỏ bớt bộ lọc.</p><button class="button secondary" id="reset-filter">Đặt lại bộ lọc</button></div>
<div class="pagination"><button class="button secondary" disabled aria-label="Trang trước">←</button><span>Trang 1 / 1 · @Model.Products.Count món</span><button class="button secondary" disabled aria-label="Trang sau">→</button></div><div class="service-note"><span>Nguyên liệu được chọn lọc</span><span>Pha mới theo từng đơn</span><span>Theo đúng khẩu vị của bạn</span></div></section>
<aside class="order-sidebar"><partial name="_ProductCustomizer"/><section class="panel fulfillment-summary"><h3>Hình thức nhận hàng</h3><div class="segmented" data-choice><button>Tại bàn</button><button>Mang đi</button><button class="selected">Giao hàng</button></div><dl class="totals"><div><dt>Tiền món</dt><dd id="catalog-subtotal">—</dd></div><div><dt>Phí giao hàng</dt><dd>Tính tại bước đặt món</dd></div><div class="total"><dt>Tạm tính món</dt><dd id="catalog-total">—</dd></div></dl><a class="button primary full" href="/Checkout">Tiếp tục đặt món →</a><p class="fine-print">Website chuyển khoản trước 100% bằng VietQR.</p></section><a class="quiet-link" href="/Cart">Xem và chỉnh sửa giỏ hàng →</a></aside></div>


<p id="catalog-message" role="status" aria-live="polite"></p>
<script id="catalog-snapshot" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Catalog, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>
@section Scripts {<script src="~/js/catalog.js" asp-append-version="true"></script>}
